generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DEV_OPS
  MARKETING_VENDAS_FINANCAS
}

enum ProjectStatus {
  PLANEJADO
  EM_ANDAMENTO
  PAUSADO
  CONCLUIDO
}

enum TaskStatus {
  A_FAZER
  EM_ANDAMENTO
  CONCLUIDA
}

enum LeadStatus {
  NOVO
  CONTATO
  NEGOCIACAO
  GANHO
  PERDIDO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role
  area         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  projects     Project[]     @relation("ProjectOwner")
  tasks        Task[]        @relation("TaskAssignee")
  activities   ActivityLog[]
  messages     Message[]     @relation("MessageSender")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANEJADO)
  priority    Priority      @default(MEDIA)
  dueDate     DateTime?
  ownerId     String?
  owner       User?         @relation("ProjectOwner", fields: [ownerId], references: [id])
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(A_FAZER)
  priority    Priority   @default(MEDIA)
  dueDate     DateTime?
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]
  sales     Sale[]
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String?
  company   String?
  status    LeadStatus @default(NOVO)
  value     Decimal    @default(0) @db.Decimal(12, 2)
  clientId  String?
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Sale {
  id        String   @id @default(cuid())
  title     String
  value     Decimal  @default(0) @db.Decimal(12, 2)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Revenue {
  id        String   @id @default(cuid())
  description String
  value     Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model Expense {
  id        String   @id @default(cuid())
  description String
  value     Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  content   String
  senderId  String
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
